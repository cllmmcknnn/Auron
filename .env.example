# Copy to .env.local and fill in. Never commit real keys.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (roadmap generation)
ANTHROPIC_API_KEY=

# Milestone emails (Resend)
RESEND_API_KEY=
# Optional. Until you verify your own domain in Resend, leave this unset: the default sender
# only delivers to the email address on your Resend account.
RESEND_FROM=
# Public URL of the deployed app, used for links in emails, e.g. https://auron.vercel.app
NEXT_PUBLIC_APP_URL=
# Any long random string. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to the cron route.
CRON_SECRET=
